{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2059-ventures",
  "main": "_worker.js",
  "compatibility_date": "2026-07-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "2059ventures.online/*", "zone_name": "2059ventures.online" },
    { "pattern": "www.2059ventures.online/*", "zone_name": "2059ventures.online" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

